# Required to run the bot at all (ingest, commands, replies all go through Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: enables sentiment analysis and the review/second-opinion pass (incl. overall_assessment).
# Without it, the pipeline still runs end-to-end, just with those stages skipped.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional: enables headline-based sentiment via NewsAPI.org instead of the free GDELT fallback.
NEWS_API_KEY=

# Optional overrides (defaults shown)
# PORTFOLIO_PATH=examples/portfolio.csv
# RISK_PROFILE_PATH=risk_profile.yaml
