# Required to run the bot at all (ingest, commands, replies all go through Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: enables screenshot parsing, sentiment analysis and the review/second-opinion
# pass (incl. overall_assessment). Without it the pipeline still runs end-to-end, just with
# those stages skipped (and holdings then have to come from a CSV instead of a screenshot).
# Gemini is the default backend: free keys at https://aistudio.google.com/apikey, and it
# needs no extra package — the calls go over plain REST.
GEMINI_API_KEY=
# Which model to call. `portfolio-agent setup` fills this in with one your key actually has.
# GEMINI_MODEL=gemini-3.8-flash
# MINIMAL | LOW | MEDIUM | HIGH on models that support it — lower spends fewer tokens.
# GEMINI_THINKING_LEVEL=
# Models to try when the main one is overloaded (503 "high demand"). Leave unset to let
# the agent ask your key what else it can call, at the moment it needs a fallback.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# To use Claude instead: set LLM_PROVIDER=anthropic, install the SDK (pip install -e ".[llm]"),
# and set ANTHROPIC_API_KEY. Needs a Rust toolchain to build on some hosts; Gemini doesn't.
# LLM_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Optional: enables headline-based sentiment via NewsAPI.org instead of the free GDELT fallback.
NEWS_API_KEY=

# Optional overrides (defaults shown)
# PORTFOLIO_PATH=examples/portfolio.csv
# RISK_PROFILE_PATH=risk_profile.yaml
